<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/._*</DefaultItemExcludes>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SmartTelescopeSort</AssemblyName>
    <RootNamespace>SmartTelescopeSort.App</RootNamespace>
    <Product>Telescope Data Sort</Product>
    <AssemblyTitle>Telescope Data Sort</AssemblyTitle>
    <Company>BigSkyAstro</Company>
    <Copyright>Open-source freeware</Copyright>
    <Description>Sorts smart and classic telescope captures into Targets {year}\{object}</Description>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.11</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmartTelescopeSort.Core\SmartTelescopeSort.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Telescope-Data-Sort-User-Manual.pdf" Condition="Exists('Assets\Telescope-Data-Sort-User-Manual.pdf')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
