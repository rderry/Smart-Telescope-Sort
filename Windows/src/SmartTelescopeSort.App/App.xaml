<Application x:Class="SmartTelescopeSort.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:SmartTelescopeSort.App.Themes"
             xmlns:dialogs="clr-namespace:SmartTelescopeSort.App.Dialogs"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVisible" />
            <themes:BoolBrushConverter x:Key="BoolBrush" />
            <themes:ThemeBrushConverter x:Key="ThemeBrush" />
            <dialogs:GroupStatusConverter x:Key="GroupStatus" />

            <DataTemplate x:Key="StatusLightTemplate">
                <StackPanel Margin="0,1,0,3" MaxWidth="280" ToolTip="{Binding Detail}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding Color, Converter={StaticResource ThemeBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Color, Converter={StaticResource ThemeBrush}}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource SubtitleBrush}" TextTrimming="CharacterEllipsis" Margin="15,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ScopeChip" TargetType="Border">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
